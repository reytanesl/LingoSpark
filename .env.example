# Copy to .env for local development. Do NOT commit .env.

# Cursor AI (Writing Suite generation)
CURSOR_API_KEY=

# App URL (no trailing slash) — e.g. https://lingospark.onrender.com
APP_BASE_URL=http://localhost:3000

# Postgres (required for auth / sessions / access)
DATABASE_URL=
# Set to false for local Postgres without SSL
DATABASE_SSL=false

# Session cookie secret (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Your Gmail = admin (case-insensitive)
ADMIN_EMAIL=

# Buy Me a Coffee — shop / extras page URL (USD checkout)
BMC_PAYMENT_URL=https://buymeacoffee.com/lingospark/extras
# Optional: direct Extra links so each plan card skips the shop listing
# BMC_WEEK_URL=https://buymeacoffee.com/lingospark/e/WEEK_EXTRA_ID
# BMC_MONTH_URL=https://buymeacoffee.com/lingospark/e/MONTH_EXTRA_ID
# BMC_YEAR_URL=https://buymeacoffee.com/lingospark/e/YEAR_EXTRA_ID
# Webhook signing secret from BMC Integrations
BMC_WEBHOOK_SECRET=

NODE_ENV=development
