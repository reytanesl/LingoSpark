# Copy to .env for local development. Do NOT commit .env.

# Same Cursor AI key used by LingoSpark
CURSOR_API_KEY=

# Google Cloud OAuth Web client ID (Drive export). Enable Google Drive API,
# create OAuth client type "Web application", and add your origins, e.g.
# http://localhost:3050 and https://lesson-creator-bvjj.onrender.com
GOOGLE_CLIENT_ID=

PORT=3050
NODE_ENV=development
